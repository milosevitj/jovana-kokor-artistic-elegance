# Long-term immutable caching for hashed Vite build assets.
# All files in /assets/ have a content hash in the filename, so they can be
# cached aggressively — when content changes, the filename changes too.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static images, fonts and icons in the public root
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# index.html must always be revalidated so users get new asset references
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
